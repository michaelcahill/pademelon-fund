---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import GalleryLayout from '../layouts/GalleryLayout.astro';
import HomeLayout from '../layouts/HomeLayout.astro';
import PageLayout from '../layouts/PageLayout.astro';
import PeopleGrid from '../components/PeopleGrid.astro';
import { splitAtCards } from '../lib/cards';
import {
  galleryFolderFor,
  galleryImages,
  photoFor,
  rewritePhotoPaths,
} from '../lib/photos';
import { injectSnippets } from '../lib/snippets';
import { pickLayout } from '../lib/layouts';
import {
  FULL_GRID,
  FULL_WIDTH,
  PROSE_CLASS,
  TEXT_COLUMN,
} from '../lib/shell';

export async function getStaticPaths() {
  // 'home' is rendered by src/pages/index.astro, not as a slug route.
  const pages = await getCollection('pages', ({ id }) => id !== 'home');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
await render(page);

// Raw HTML snippets: `{{snippet-name}}` placeholders become the snippet's
// verbatim HTML (src/lib/snippets.ts). Everything below renders this string,
// which is exactly what <Content /> would have output, placeholders resolved.
// Photos in the body are written as `/images/<file>` (the CMS inserts that shape),
// so they are pointed at the build-time assets before rendering.
const bodyHtml = await rewritePhotoPaths(await injectSnippets(page.rendered?.html ?? ''));

// A page becomes a gallery when its image folder has images in it.
const folder = galleryFolderFor(page.data, page.id);
const images = galleryImages(folder, page.data.captions);
const layout = pickLayout(page.data.layout, images.length);

// `cards: people` splits this page around its `<!-- cards -->` marker. The two
// halves are the same HTML `<Content />` would render (RenderedContent holds it),
// which lets the grid sit between them.
const cards = page.data.cards;
const split = cards ? splitAtCards(bodyHtml) : undefined;
---

{
  layout === 'gallery' ? (
    <GalleryLayout
      title={page.data.title}
      description={page.data.description}
      images={images}
      group={folder}
      aspect={page.data.galleryAspect}
      // A page can name its own preview image; without one GalleryLayout uses
      // the first tile of the folder (and its caption).
      image={photoFor(page.data.heroImage)}
      imageAlt={page.data.heroAlt}
    >
      <div slot="intro" class={PROSE_CLASS} set:html={bodyHtml} />
    </GalleryLayout>
  ) : layout === 'home' ? (
    <HomeLayout
      title={page.data.title}
      description={page.data.description}
      heroImage={photoFor(page.data.heroImage)}
      heroAlt={page.data.heroAlt ?? page.data.title}
    >
      <div class={PROSE_CLASS} set:html={bodyHtml} />
    </HomeLayout>
  ) : (
    <PageLayout
      title={page.data.title}
      description={page.data.description}
      heroImage={photoFor(page.data.heroImage)}
      heroAlt={page.data.heroAlt}
    >
      {/* Text above the marker stays in PageLayout's own prose block. */}
      {split ? <Fragment set:html={split.before} /> : <Fragment set:html={bodyHtml} />}

      <!-- The grid goes in the `after` slot, outside PageLayout's `.prose`
           wrapper, so the typography plugin cannot add its 2em image margins
           around each portrait; any text written below the marker follows it in
           matching prose styling. Without a marker the cards simply come last. -->
      {cards ? (
        /* The `after` slot nests the same three-column split: cards span all
           three columns, any trailing prose reads in the right two. */
        <div slot="after" class:list={[FULL_GRID]}>
          <div class:list={[FULL_WIDTH]}>
            <PeopleGrid />
          </div>
          {split?.after ? (
            <div
              class:list={[PROSE_CLASS, 'mt-10', TEXT_COLUMN]}
              set:html={split.after}
            />
          ) : null}
        </div>
      ) : null}
    </PageLayout>
  )
}
