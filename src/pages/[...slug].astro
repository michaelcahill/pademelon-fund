---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import GalleryLayout from '../layouts/GalleryLayout.astro';
import HomeLayout from '../layouts/HomeLayout.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { galleryFolderFor, getGalleryImages } from '../lib/galleries';
import { pickLayout } from '../lib/layouts';

export async function getStaticPaths() {
  // 'home' is rendered by src/pages/index.astro, not as a slug route.
  const pages = await getCollection('pages', ({ id }) => id !== 'home');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { Content } = await render(page);

// A page becomes a gallery when its image folder has images in it.
const folder = galleryFolderFor(page.data, page.id);
const images = getGalleryImages(folder);
const layout = pickLayout(page.data.layout, images.length);
---

{
  layout === 'gallery' ? (
    <GalleryLayout
      title={page.data.title}
      description={page.data.description}
      images={images}
      group={folder}
      aspect={page.data.galleryAspect}
    >
      <div slot="intro" class="prose prose-slate prose-emerald max-w-none">
        <Content />
      </div>
    </GalleryLayout>
  ) : layout === 'home' ? (
    <HomeLayout
      title={page.data.title}
      description={page.data.description}
      heroImage={page.data.heroImage}
      heroAlt={page.data.heroAlt ?? page.data.title}
    >
      <div class="prose prose-slate prose-emerald max-w-none">
        <Content />
      </div>
    </HomeLayout>
  ) : (
    <PageLayout
      title={page.data.title}
      description={page.data.description}
      heroImage={page.data.heroImage}
      heroAlt={page.data.heroAlt}
    >
      <Content />
    </PageLayout>
  )
}
