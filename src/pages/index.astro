---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pademelon Fund" description="Supporting effective animal advocacy in Australia.">
  <div class="max-w-3xl">
    <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight mb-6">
      Pademelon Fund
    </h1>
    <p class="text-lg text-slate-600 leading-relaxed mb-8">
      We support high-impact animal advocacy organisations in Australia. Explore our
      <a href="/news" class="text-emerald-700 hover:text-emerald-800 font-medium transition">news</a>
      to learn about our work and impact.
    </p>
    <div class="flex flex-wrap gap-4">
      <a
        href="/news"
        class="inline-block px-6 py-3 bg-emerald-700 text-white rounded-lg hover:bg-emerald-800 transition font-medium"
      >
        Read News
      </a>
      <a
        href="/about"
        class="inline-block px-6 py-3 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-100 transition font-medium"
      >
        About us
      </a>
      <a
        href="/founders"
        class="inline-block px-6 py-3 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-100 transition font-medium"
      >
        The Founders
      </a>
      <a
        href="/our-partners"
        class="inline-block px-6 py-3 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-100 transition font-medium"
      >
        Our Partners
      </a>
      <a
        href="/impact"
        class="inline-block px-6 py-3 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-100 transition font-medium"
      >
        Impact
      </a>
      <a
        href="/contact-us"
        class="inline-block px-6 py-3 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-100 transition font-medium"
      >
        Contact us
      </a>
    </div>
  </div>
</Layout>
