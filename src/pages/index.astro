---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Pademelon Fund" description="Supporting grassroots action for nature, First Nations and climate across Australia.">
  <div class="max-w-3xl">
    <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight mb-6">
      Pademelon Fund
    </h1>
    <p class="text-lg text-slate-600 leading-relaxed mb-8">
      We support grassroots action for nature, First Nations and climate across Australia.
      Explore our <a href={base + "/news"} class="text-emerald-700 hover:text-emerald-800 font-medium transition">news</a> to learn about our work and impact,
      or visit our <a href={base + "/about"} class="text-emerald-700 hover:text-emerald-800 font-medium transition">about page</a>.
    </p>
  </div>
</Layout>
