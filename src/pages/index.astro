---
import { getCollection, render } from 'astro:content';
import HomeLayout from '../layouts/HomeLayout.astro';
import { injectSnippets } from '../lib/snippets';
import { PROSE_CLASS } from '../lib/shell';

const home = await getCollection('pages', ({ id }) => id === 'home').then(
  (pages) => pages[0],
);

if (!home) {
  throw new Error('Missing required content page: src/content/pages/home.md');
}

await render(home);

// `{{snippet-name}}` placeholders become verbatim HTML (src/lib/snippets.ts).
const bodyHtml = await injectSnippets(home.rendered?.html ?? '');
---

<HomeLayout
  title={home.data.title}
  description={home.data.description}
  heroImage={home.data.heroImage}
  heroAlt={home.data.heroAlt ?? home.data.title}
>
  <div class={PROSE_CLASS} set:html={bodyHtml} />
</HomeLayout>
