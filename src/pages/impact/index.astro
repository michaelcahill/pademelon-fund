---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isDocumentPath } from '../../lib/documents';
import { CARD_WIDTHS, countGalleryImages, galleryFolderFor, photoFor } from '../../lib/photos';
import { withBase } from '../../lib/paths';
import { FULL_WIDTH } from '../../lib/shell';

const impactPosts = (await getCollection('impact')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Shared by the <meta> tags and the visible standfirst so they cannot drift.
const description =
  "Explore the impact of Pademelon Fund's work — the projects and people we support.";
---

<BaseLayout title="Impact" description={description}>
  <!-- Title, standfirst and the card grid span all three columns; the pademelon
       watermark keeps the left column clear (see src/lib/shell.ts). -->
  <h1 class:list={['text-3xl font-extrabold tracking-tight sm:text-4xl', FULL_WIDTH]}>
    Impact
  </h1>

  <p class:list={['mt-3 text-lg leading-relaxed', FULL_WIDTH]}>
    {description}
  </p>

  {
    impactPosts.length === 0 ? (
      <p class:list={['mt-6', FULL_WIDTH]}>
        No impact stories posted yet. Check back soon.
      </p>
    ) : (
      // One column on phones, two from small tablets up.
      <ul class:list={['mt-8 grid gap-6 sm:grid-cols-2', FULL_WIDTH]}>
        {impactPosts.map((post) => {
          const photoCount = countGalleryImages(galleryFolderFor(post.data, post.id));

          // Frontmatter `link` redirects the image and title — to an outside page, or
          // to a site path such as /documents/x.pdf. The story keeps its own
          // /impact/<slug> URL and the "Read more" CTA always goes there, so a
          // redirected card still leads to the post. Site paths get the base path
          // added; only true external URLs open in a new tab.
          const link = post.data.link;
          const isExternal = !!link && /^https?:\/\//.test(link);
          const storyHref = withBase(`/impact/${post.id}`);
          const href = link ? withBase(link) : storyHref;
          const externalAttrs = isExternal
            ? { target: '_blank', rel: 'noopener noreferrer' }
            : {};
          // Astro's prefetcher watches every internal link and does not filter by
          // file type, so a card pointing at a PDF opts out with this attribute
          // (the same one the skipUploadPrefetch plugin writes in astro.config.mjs).
          const prefetchAttrs = isDocumentPath(href)
            ? { 'data-astro-prefetch': 'false' }
            : {};

          return (
            <li class="card flex flex-col">
              <!-- The image is a link to the card's destination: frontmatter `link`
                   when set, otherwise the story page. Same href as the title below;
                   the CTA at the end of the card always goes to the story. -->
              {photoFor(post.data.image) ? (
                <a href={href} {...externalAttrs} {...prefetchAttrs} class="block">
                  <Image
                    src={photoFor(post.data.image)!}
                    alt={post.data.imageAlt ?? ''}
                    widths={CARD_WIDTHS}
                    format="webp"
                    class="aspect-[16/9] w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ) : null}

              <div class="flex flex-grow flex-col p-5">
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="text-xs font-semibold uppercase tracking-wider"
                >
                  {post.data.pubDate.toLocaleDateString('en-AU', { dateStyle: 'medium' })}
                </time>

                <h2 class="mt-2 text-lg font-bold leading-snug">
                  <a href={href} {...externalAttrs} {...prefetchAttrs}>
                    {post.data.title}
                  </a>
                </h2>

                <p class="mt-2 grow text-sm leading-relaxed">
                  {post.data.description}
                </p>

                <div class="mt-4 flex items-center gap-3 text-xs font-medium">
                  <a
                    href={storyHref}
                    class="inline-flex min-h-11 items-center"
                  >
                    Read more &rarr;
                  </a>

                  {photoCount > 0 ? (
                    <span>
                      · {photoCount} photo{photoCount === 1 ? '' : 's'}
                    </span>
                  ) : null}
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    )
  }
</BaseLayout>
