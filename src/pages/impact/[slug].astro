---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import GalleryLayout from '../../layouts/GalleryLayout.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import {
  galleryFolderFor,
  galleryImages,
  photoFor,
  rewritePhotoPaths,
} from '../../lib/photos';
import { pickLayout } from '../../lib/layouts';
import { PROSE_CLASS } from '../../lib/shell';
import { injectSnippets } from '../../lib/snippets';
import { impactHref } from '../../lib/navigation';

export async function getStaticPaths() {
  const posts = await getCollection('impact');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'impact'>;
}

const { post } = Astro.props;
await render(post);

// `{{snippet-name}}` placeholders become verbatim HTML (src/lib/snippets.ts).
// Photos in the body are written as `/images/<file>` (the CMS inserts that shape),
// so they are pointed at the build-time assets before rendering.
const bodyHtml = rewritePhotoPaths(await injectSnippets(post.rendered?.html ?? ''));

// A post becomes a gallery when its image folder has images in it.
const folder = galleryFolderFor(post.data, post.id);
const images = galleryImages(folder, post.data.captions);
const layout = pickLayout(post.data.layout, images.length);
---

{
  layout === 'gallery' ? (
    <GalleryLayout
      title={post.data.title}
      description={post.data.description}
      pubDate={post.data.pubDate}
      images={images}
      group={folder}
      aspect={post.data.galleryAspect}
      // `image` is optional frontmatter; GalleryLayout falls back to the first
      // tile, which is what a gallery post shows at the top of the page.
      image={photoFor(post.data.image)}
      imageAlt={post.data.imageAlt}
      ogType="article"
      backHref={impactHref}
      backLabel="Back to all impact stories"
    >
      <div slot="intro" class={PROSE_CLASS} set:html={bodyHtml} />
    </GalleryLayout>
  ) : (
    <PageLayout
      title={post.data.title}
      description={post.data.description}
      pubDate={post.data.pubDate}
      heroImage={photoFor(post.data.image)}
      heroAlt={post.data.imageAlt ?? post.data.title}
      ogType="article"
      backHref={impactHref}
      backLabel="Back to all impact stories"
    >
      <Fragment set:html={bodyHtml} />
    </PageLayout>
  )
}
