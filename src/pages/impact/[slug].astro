---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import GalleryLayout from '../../layouts/GalleryLayout.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { galleryFolderFor, getGalleryImages } from '../../lib/galleries';
import { pickLayout } from '../../lib/layouts';
import { impactHref } from '../../lib/navigation';

export async function getStaticPaths() {
  const posts = await getCollection('impact');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'impact'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

// A post becomes a gallery when its image folder has images in it.
const folder = galleryFolderFor(post.data, post.id);
const images = getGalleryImages(folder, post.data.captions);
const layout = pickLayout(post.data.layout, images.length);
---

{
  layout === 'gallery' ? (
    <GalleryLayout
      title={post.data.title}
      description={post.data.description}
      pubDate={post.data.pubDate}
      images={images}
      group={folder}
      aspect={post.data.galleryAspect}
      backHref={impactHref}
      backLabel="Back to all impact stories"
    >
      <div slot="intro" class="prose prose-slate prose-emerald max-w-none">
        <Content />
      </div>
    </GalleryLayout>
  ) : (
    <PageLayout
      title={post.data.title}
      description={post.data.description}
      pubDate={post.data.pubDate}
      heroImage={post.data.image}
      heroAlt={post.data.imageAlt ?? post.data.title}
      backHref={impactHref}
      backLabel="Back to all impact stories"
    >
      <Content />
    </PageLayout>
  )
}
