---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { photoFor } from '../lib/photos';
import { FULL_WIDTH } from '../lib/shell';

interface Partner {
  name: string;
  description?: string;
  /** Logo path in content (`/images/partners/nic.png`) resolved by `photoFor()`. */
  logo?: ImageMetadata;
  /** Optional organisation website. */
  link?: string;
  order?: number;
}

const partners: Partner[] = (await getCollection('partners'))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((p) => ({ ...p.data, logo: photoFor(p.data.logo) }));
---

<BaseLayout
  title="Our Partners"
  description="The philanthropic circles and partners Pademelon Fund works with."
>
  <!-- The width cap sits on the heading, not the article, so the description
       below spans the full container. -->
  <article class:list={[FULL_WIDTH]}>
    <h1 class="max-w-prose text-3xl font-extrabold tracking-tight sm:text-4xl">
      Our Partners
    </h1>
    <p class="mt-5 text-lg leading-relaxed">
      The Pademelon Fund is an active member of philanthropic circles, including
      the Australian Environmental Grantmakers' Network (AEGN), the Nature Impact
      Collective (NIC), Groundswell Giving, and Philanthropy Australia.
    </p>
  </article>

  <ul class:list={['mt-10 grid gap-6 sm:grid-cols-2', FULL_WIDTH]}>
    {partners.map((partner) => (
      <li class="card flex flex-col p-6">
        {partner.logo ? (
          partner.link ? (
            <a
              href={partner.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex"
            >
              <Image
                src={partner.logo!}
                alt={partner.name}
                format="webp"
                loading="lazy"
                decoding="async"
                class="h-20 w-full object-contain"
              />
            </a>
          ) : (
            <Image
              src={partner.logo!}
              alt={partner.name}
              format="webp"
              loading="lazy"
              decoding="async"
              class="h-20 w-full object-contain"
            />
          )
        ) : (
          partner.link ? (
            <a
              href={partner.link}
              target="_blank"
              rel="noopener noreferrer"
              class="text-base font-bold"
            >
              {partner.name}
            </a>
          ) : (
            <span class="text-base font-bold">{partner.name}</span>
          )
        )}

        <h2 class="mt-4 text-lg font-bold leading-snug">
          {partner.name}
        </h2>

        {partner.description ? (
          <p class="mt-2 grow text-sm leading-relaxed">
            {partner.description}
          </p>
        ) : null}

      </li>
    ))}
  </ul>
</BaseLayout>
