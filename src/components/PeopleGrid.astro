---
import { render } from "astro:content";
import { getPeople, portraitFor, type Person } from "../lib/people";

interface Props {
    /** Optional heading above the grid (level 2). */
    heading?: string;
    /** Cards per row on wide screens. Two keeps long bios readable. */
    columns?: 2 | 3;
    /** Restrict the grid to these slugs (in this order). Empty = everyone. */
    only?: string[];
}

const { heading, columns = 2, only = [] } = Astro.props;

const all = await getPeople();
const people: Person[] = only.length
    ? (only
          .map((slug) => all.find((p) => p.id === slug))
          .filter(Boolean) as Person[])
    : all;

const cards = await Promise.all(
    people.map(async (person) => ({
        person,
        Content: (await render(person)).Content,
    })),
);

const gridClass =
    columns === 3
        ? "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
        : "grid-cols-1 sm:grid-cols-2";
---

{people.length > 0 ? (
    <section class="mt-10">
        {heading ? (
            <h2 class="text-2xl font-extrabold tracking-tight">{heading}</h2>
        ) : null}

        <ul class:list={["mt-6 grid gap-6", gridClass]}>
            {cards.map(({ person, Content }) => (
                <li class="card flex flex-col">
                    <!-- The portrait links to the person's site when they have one,
                         matching the partner cards (partners.astro). No link means
                         the portrait stays a plain image. -->
                    {portraitFor(person) ? (
                        person.data.link ? (
                            <a
                                href={person.data.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="block"
                            >
                                <img
                                    src={portraitFor(person)}
                                    alt={person.data.imageAlt ?? person.data.name}
                                    class="aspect-square w-full object-cover"
                                    loading="lazy"
                                    decoding="async"
                                />
                            </a>
                        ) : (
                            <img
                                src={portraitFor(person)}
                                alt={person.data.imageAlt ?? person.data.name}
                                class="aspect-square w-full object-cover"
                                loading="lazy"
                                decoding="async"
                            />
                        )
                    ) : null}

                    <div class="flex grow flex-col p-6">
                        <h2 class="text-lg font-bold leading-snug">
                            {person.data.name}
                        </h2>

                        {person.data.role ? (
                            <h3 class="mt-1 text-xs font-semibold uppercase tracking-wider">
                                {person.data.role}
                            </h3>
                        ) : null}

                        <!-- The bio is the markdown file's body: prose, lists and links all work. -->
                        <div class="prose prose-sm mt-4 grow max-w-none">
                            <Content />
                        </div>

                        {person.data.link ? (
                            <a
                                href={person.data.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold"
                            >
                                {person.data.linkLabel ?? "More"} &rarr;
                            </a>
                        ) : null}
                    </div>
                </li>
            ))}
        </ul>
    </section>
) : null}
