---
// Reactive full-viewport background for the green colour scheme.
//
//  - Parallax: the image drifts slower than page scroll (scroll-driven).
//  - Section-aware: swaps the image when a section scrolls into view. Sections
//    declare their image via a `data-bg` attribute whose value matches a key
//    in the `images` map.
//  - Respects `prefers-reduced-motion`: parallax is disabled when requested.
//  - Progressive enhancement: with JS disabled the <body> green background
//    remains and the page is fully usable — no image, no animation.
//  - No default image: pass `defaultImage` (and optionally `images`) to enable
//    a background photo. Without one, only the green canvas is shown.
//
// Alpine.js (v3, a project dependency) drives the reactivity. Alpine is
// started and the `background` data component is registered in BaseLayout.astro.

interface Props {
  /** Image shown before any section is in view. Omit for a plain green bg. */
  defaultImage?: string;
  /** Map of `data-bg` value → image URL, for section-aware swapping. */
  images?: Record<string, string>;
}

const { defaultImage, images = {} } = Astro.props;

// Merge the default into the images map so init() has a single source of truth.
const allImages = { ...images, default: defaultImage };
---

<div
  x-data="background()"
  x-init="init()"
  data-bg-images={JSON.stringify(allImages)}
  class="fixed inset-0 -z-10 overflow-hidden"
>
  <!-- Green base layer: the canvas, always visible. -->
  <div class="absolute inset-0 bg-green-bg"></div>

  <!-- Reactive image layer. Hidden (`x-show`) when no image is set, so only the
       green canvas shows. Alpine sets `background-image` (section swap) via its
       `current` property, and writes `--bg-y` (parallax) directly in the scroll
       handler. The `parallax-bg` utility reads `--bg-y` in CSS — compositor-
       friendly, no JS-driven transforms. -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat parallax-bg"
    x-bind:style='`background-image: url(${current});`'
    x-show="current"
    x-cloak
  >
    <!-- Dark green tint keeps foreground content legible over the photo. -->
    <div class="absolute inset-0 bg-emerald-950/60"></div>
  </div>
</div>
