---
import { getImage, Image } from 'astro:assets';
import Lightbox from './Lightbox.astro';
import type { GalleryImage } from '../lib/photos';
import { TILE_WIDTHS } from '../lib/photos';

interface Props {
  images: GalleryImage[];
  /** Groups the images in the lightbox so prev/next stay inside this gallery. */
  group?: string;
  /**
   * CSS aspect-ratio for each tile, e.g. `3/2` for landscape photos or `16/9`.
   * Set it to match the source photos so nothing is visibly cropped.
   */
  aspect?: string;
  /** Print each image's caption beneath the tile as well as in the lightbox. */
  showCaptions?: boolean;
}

const { images, group = 'gallery', aspect = '3/2', showCaptions = false } = Astro.props;

// A single image should not be shrunk into a thumbnail grid.
// Three columns is the widest useful option inside the page shell (max-w-4xl):
// a fourth column would make each tile too small to see, so it is not used even
// on large screens.
const gridClass =
  images.length === 1
    ? 'grid-cols-1'
    : images.length === 2
      ? 'grid-cols-1 sm:grid-cols-2'
      : 'grid-cols-2 md:grid-cols-3';

// The tile shows a WebP rendition at 267/534 px (see TILE_WIDTHS), but the lightbox
// opens the full picture, so each photo gets one rendition at the hero width (1664px —
// fills a 1920px window). Built once at build time, so the page only carries URLs.
const tiles = await Promise.all(
  images.map(async (img) => ({
    ...img,
    full: (await getImage({ src: img.meta, width: 1664, format: 'webp' })).src,
  })),
);
---

{
  images.length === 0 ? (
    <p class="empty p-6 text-center text-sm">
      No images in this gallery yet. Add image files to the gallery folder to see them here.
    </p>
  ) : (
    <>
      <ul class:list={['grid gap-3 sm:gap-4', gridClass]}>
        {tiles.map((tile, index) => (
          <li>
            <figure class="group">
              <a
                href={tile.full}
                class="tile block overflow-hidden focus-visible:outline-2 focus-visible:outline-offset-2"
                style={`aspect-ratio: ${aspect}`}
                data-lightbox=""
                data-gallery={group}
                data-title={tile.alt}
                data-alt={tile.alt}
                aria-label={`Open image: ${tile.alt || `image ${index + 1}`}`}
              >
                <Image
                  src={tile.meta}
                  alt={tile.alt}
                  widths={TILE_WIDTHS}
                  format="webp"
                  /* The inline aspect-ratio reserves the space, so no CLS; the first
                     two tiles are on the first screen, the rest load as you scroll. */
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                  style={`aspect-ratio: ${aspect}`}
                  class="size-full object-cover transition duration-300 motion-safe:group-hover:scale-[1.03]"
                />
              </a>

              {showCaptions && tile.alt ? (
                <figcaption class="mt-2 text-xs leading-snug">
                  {tile.alt}
                </figcaption>
              ) : null}
            </figure>
          </li>
        ))}
      </ul>

      <Lightbox />
    </>
  )
}
