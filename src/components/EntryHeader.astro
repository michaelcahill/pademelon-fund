---
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  /** Standfirst shown under the title. */
  description?: string;
  pubDate?: Date;
  /** Site-absolute path (base-relative paths from frontmatter are fixed up). */
  heroImage?: string;
  heroAlt?: string;
  /** Tailwind width class for the heading/lead text on wide pages. */
  textClass?: string;
  /**
   * Classes for the `<header>` element itself. Used for its span in the
   * three-column page shell (`FULL_WIDTH` — see src/lib/shell.ts). Astro does
   * not merge a `class` prop into a component's root, so this has to be an
   * explicit prop applied inside the component.
   */
  rootClass?: string;
}

const {
  title,
  description,
  pubDate,
  heroImage,
  heroAlt,
  textClass = 'max-w-2xl',
  rootClass,
} = Astro.props;
---

<header class:list={[rootClass]}>
  {
    pubDate ? (
      <time
        datetime={pubDate.toISOString()}
        class="text-xs font-semibold uppercase tracking-wider"
      >
        {pubDate.toLocaleDateString('en-AU', { dateStyle: 'long' })}
      </time>
    ) : null
  }

  <h1
    class:list={[
      'mt-1 text-3xl font-extrabold tracking-tight sm:text-4xl',
      textClass,
    ]}
  >
    {title}
  </h1>

  <!-- Deliberately not width-capped by `textClass`: headings stay in the narrow
       column, but the standfirst spans the full container. -->
  {description ? <p class="mt-3 text-lg leading-relaxed">{description}</p> : null}

  {heroImage ? (
    <img
      src={withBase(heroImage)}
      alt={heroAlt ?? ''}
      class="mt-6 aspect-[3/2] w-full rounded-xl object-cover sm:rounded-2xl"
      decoding="async"
      fetchpriority="high"
    />
  ) : null}
</header>
