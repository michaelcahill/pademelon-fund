---
import { isActive, navItems, homeHref } from '../lib/navigation';
import { SHELL_CONTAINER } from '../lib/shell';

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <div
    class:list={[
      'relative flex h-16 items-center justify-between gap-4',
      SHELL_CONTAINER,
    ]}
  >
    <a
      href={homeHref}
      class="shrink-0 text-lg font-bold text-emerald-800 transition hover:text-emerald-900"
    >
      Pademelon Fund
    </a>

    <!-- Wide screens: horizontal menu -->
    <nav class="nav-bar" aria-label="Main">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(currentPath, item.href) ? 'page' : undefined}
            class:list={['nav-link', { 'nav-link-active': isActive(currentPath, item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Narrow screens: toggle -->
    <button
      type="button"
      class="nav-toggle rounded-md px-3"
      aria-expanded="false"
      aria-controls="site-menu"
      data-nav-toggle
    >
      <span class="sr-only">Menu</span>
      <svg
        class="icon-open size-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg
        class="icon-close size-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <!-- Narrow screens: dropdown panel -->
  <div class="nav-panel" id="site-menu" data-open="false" data-nav-panel>
    <nav aria-label="Main">
      <ul class="divide-y divide-slate-100">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(currentPath, item.href) ? 'page' : undefined}
                class:list={[
                  'nav-link-mobile',
                  isActive(currentPath, item.href) && 'bg-slate-50 text-emerald-700',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');

  if (header) {
    const toggle = header.querySelector('[data-nav-toggle]');
    const panel = header.querySelector('[data-nav-panel]');

    if (toggle instanceof HTMLElement && panel) {
      const setOpen = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open));
        panel.setAttribute('data-open', String(open));
      };
      const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

      toggle.addEventListener('click', () => setOpen(!isOpen()));

      // Close after choosing a destination.
      panel.addEventListener('click', (event) => {
        if ((event.target as Element | null)?.closest('a')) setOpen(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isOpen()) {
          setOpen(false);
          toggle.focus();
        }
      });

      // Reset state when the dropdown is no longer needed. The breakpoint is read
      // from CSS (--breakpoint-nav) so JavaScript and styles cannot drift apart.
      const cssBreakpoint = getComputedStyle(document.documentElement)
        .getPropertyValue('--breakpoint-nav')
        .trim();
      const wide = window.matchMedia(`(min-width: ${cssBreakpoint || '52rem'})`);
      const onChange = (event: MediaQueryListEvent) => {
        if (event.matches) setOpen(false);
      };
      if (typeof wide.addEventListener === 'function') wide.addEventListener('change', onChange);
    }
  }
</script>
