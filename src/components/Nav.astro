---
import { isActive, navItems, homeHref } from "../lib/navigation";
import { SHELL_CONTAINER } from "../lib/shell";

const currentPath = Astro.url.pathname;
---

<header class="site-header">
    <div
        class:list={[
            "relative flex min-h-16 flex-wrap items-center justify-between gap-4 py-1",
            SHELL_CONTAINER,
        ]}
    >
        <a
            href={homeHref}
            class="flex shrink-0 items-center gap-1 text-lg font-bold"
        >
            <img
                src="/images/pademelon-logo-small.png"
                alt="Pademelon Fund logo"
                width={64}
                height={64}
                class="gap-1"
                loading="eager"
            />
            Pademelon Fund
        </a>

        <!-- Wide screens: horizontal menu -->
        <nav class="nav-bar" aria-label="Main">
            {navItems.map((item) => (
                <a
                    href={item.href}
                    aria-current={
                        isActive(currentPath, item.href) ? "page" : undefined
                    }
                    class:list={[
                        "nav-link",
                        { "nav-link-active": isActive(currentPath, item.href) },
                    ]}
                >
                    {item.label}
                </a>
            ))}
        </nav>

        <!-- Narrow screens: toggle -->
        <button
            type="button"
            class="nav-toggle rounded-md px-3"
            aria-expanded="false"
            aria-controls="site-menu"
            data-nav-toggle
        >
            <span class="sr-only">Menu</span>
            <svg
                class="icon-open size-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                aria-hidden="true"
            >
                <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <svg
                class="icon-close size-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                aria-hidden="true"
            >
                <path d="M6 6l12 12M18 6L6 18" />
            </svg>
        </button>

        <!-- Narrow screens: dropdown panel. The same white card as the footer
             menu, right-aligned under the hamburger. It sits inside the row (the
             `relative` element capped by SHELL_CONTAINER), so its right edge lines
             up with the toggle instead of the viewport edge. -->
        <div
            class="nav-panel card"
            id="site-menu"
            data-open="false"
            data-nav-panel
        >
            <nav aria-label="Main">
                <ul class="divide-y divide-slate-100">
                    {navItems.map((item) => (
                        <li>
                            <a
                                href={item.href}
                                aria-current={
                                    isActive(currentPath, item.href)
                                        ? "page"
                                        : undefined
                                }
                                class="nav-link-mobile"
                            >
                                {item.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </div>
    </div>
</header>

<script>
    // Wiring is shared with the footer hamburger (src/lib/nav-menu.ts): each
    // toggle drives the panel named by its `aria-controls`, so this button keeps
    // the dropdown under the header and the footer opens its own card. The
    // module installs its listeners once, whichever component calls it first.
    import { initSiteMenu } from "../lib/nav-menu";

    initSiteMenu();
</script>
