---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Background from '../components/Background.astro';
import Watermark from '../components/Watermark.astro';
import { withBase } from '../lib/paths';
import { defaultShareImage, shareImageUrl } from '../lib/share';
import { defaultDescription, pageTitle, siteName } from '../lib/site';
import { SHELL_CONTAINER, SHELL_GRID } from '../lib/shell';

interface Props {
  title: string;
  description?: string;
  /** Hero image for link previews: site-absolute path (`/images/x.jpg`) or full URL.
      Omit to use the site logo (`defaultShareImage`). */
  image?: string;
  /** Caption for the preview image (`og:image:alt` / `twitter:image:alt`). */
  imageAlt?: string;
  /** `og:type`: `article` for dated stories, `website` for everything else. */
  ogType?: 'website' | 'article';
  /** Publication date, written as `article:published_time` for impact posts. */
  pubDate?: Date;
}

const {
  title,
  description = defaultDescription,
  image,
  imageAlt,
  ogType = 'website',
  pubDate,
} = Astro.props;
const fullTitle = pageTitle(title);
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin).href;
// Preview services fetch the image by absolute URL, so it is resolved against
// the canonical origin (`site` in astro.config.mjs), not left base-relative.
const hasImage = !!image;
const shareImage = shareImageUrl(image ?? defaultShareImage, origin);
// Alt text describes the picture, so it follows whichever one is used: the page's
// own caption (else its title) for a hero, and the site name for the logo fallback.
const shareAlt = hasImage ? imageAlt ?? title : siteName;
---

<!DOCTYPE html>
<html lang="en" class="min-h-screen-safe">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover lets us pad around the iPhone notch ourselves. -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#3d4746" />

    <!-- Link previews. Facebook/WhatsApp/Messenger/iMessage/Slack/LinkedIn read
         the `og:*` block; X (twitter:) ignores it and reads its own keys, so the
         card is written twice from the same values. The image is the page's hero,
         falling back to the site logo (`defaultShareImage`). -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    {shareAlt ? <meta property="og:image:alt" content={shareAlt} /> : null}
    {pubDate ? (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    ) : null}

    <!-- `summary_large_image` is the wide card; the site's heroes are landscape,
         so it matches. X wants an image under 1 MB (see scripts/image-audit.md). -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    {shareAlt ? <meta name="twitter:image:alt" content={shareAlt} /> : null}

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="apple-touch-icon" href={withBase('/favicon.png')} />

    <!-- Recorded before paint so narrow screens never flash an open menu. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <slot name="head" />
  </head>

  <body class="flex min-h-screen-safe flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-emerald-700 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to content
    </a>

    <!-- Reactive green background (parallax + section image swap). Its script
         lives inside the component. -->
    <Background />

    <Nav />

    <!-- `content-start` (align-content) pins the rows to the top of main.
         Without it the default `align-content: normal` behaves as `stretch`,
         and because every row here is auto-sized, the free space in a tall
         window is shared between them — each grid item's row grows and the
         page visibly spreads down the screen. Stretching main (flex-grow) is
         what keeps the footer at the bottom; this keeps the content at the
         top and puts all the leftover room below it. -->
    <main
      id="main"
      class:list={[
        'relative flex-grow content-start py-10 sm:py-12',
        SHELL_CONTAINER,
        SHELL_GRID,
      ]}
    >
      <!-- The pademelon drawing on every page. Its column probe, the image and the
           floating/resting positioning all live in src/components/Watermark.astro,
           so the measurement code sits with the markup it drives. Both root nodes
           are children of `main`: the probe is the column-1 grid item (zero-height,
           so it cannot shift content) and the image is fixed/absolute, so neither
           takes a grid cell. -->
      <Watermark />

      <!-- Slot children are grid items, so each block declares its own span:
           `TEXT_COLUMN` (right two columns) for reading text, `FULL_WIDTH`
           (all three) for titles, descriptions, hero images and card grids.
           Layouts nest the same split with `FULL_GRID`. -->
      <slot />
    </main>

    <Footer />
  </body>
</html>
