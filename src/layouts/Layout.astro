---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Pademelon Fund Site" } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Determine the current path for active nav state
const currentPath = new URL(Astro.request.url).pathname;
const navItems = [
  { href: base + "/founders", label: "The Founders" },
  { href: base + "/our-partners", label: "Our Partners" },
  { href: base + "/impact", label: "Impact" },
  { href: base + "/co-funding", label: "Co-funding" },
  { href: base + "/contact-us", label: "Contact us" },
  { href: base + "/news", label: "News" },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={base + "/favicon.png"} />
    <link rel="apple-touch-icon" href={base + "/favicon.png"} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-white text-slate-800 antialiased min-h-screen flex flex-col">
    <!-- Header / Navigation -->
    <header class="site-header">
      <div class="header-container">
        <a href={base || '/'} class="font-bold text-lg text-emerald-800 hover:text-emerald-900 transition">
          Pademelon Fund
        </a>
        <nav class="flex space-x-8 text-sm font-medium">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "nav-link",
                { "nav-link-active": currentPath === item.href },
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-col">
          <h2 class="text-xl font-bold text-slate-900 mb-3">Pademelon Fund</h2>
          <p class="text-sm text-slate-500">
            Supporting grassroots action for nature, First Nations and climate across Australia.
          </p>
        </div>
        <div class="footer-col-links">
          <h3 class="text-sm font-semibold text-slate-900 mb-3">Pages</h3>
          <ul class="space-y-2 text-sm">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-slate-500 hover:text-emerald-700 transition"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="footer-col-links">
          <h3 class="text-sm font-semibold text-slate-900 mb-3">Connect</h3>
          <ul class="space-y-2 text-sm">
            <li><a href={base + "/news"} class="text-slate-500 hover:text-emerald-700 transition">News</a></li>
            <li><a href={base + "/contact-us"} class="text-slate-500 hover:text-emerald-700 transition">Contact</a></li>
          </ul>
        </div>
      </div>
      <div class="max-w-4xl mx-auto px-6 mt-8 pt-6 border-t border-slate-200 text-center text-xs text-slate-400">
        &copy; {new Date().getFullYear()} Pademelon Fund. All rights reserved.
      </div>
    </footer>
  </body>
</html>
