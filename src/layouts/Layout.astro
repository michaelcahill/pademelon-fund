---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Pademelon Fund Site" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">
    <!-- Header / Navigation -->
    <header class="bg-white border-b border-slate-200">
      <div class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-bold text-lg text-emerald-800 hover:text-emerald-900 transition">
          Pademelon Fund
        </a>
        <nav class="flex space-x-6 text-sm font-medium text-slate-600">
          <a href="/about" class="hover:text-emerald-700 transition">About us</a>
          <a href="/founders" class="hover:text-emerald-700 transition">The Founders</a>
          <a href="/our-partners" class="hover:text-emerald-700 transition">Our Partners</a>
          <a href="/impact" class="hover:text-emerald-700 transition">Impact</a>
          <a href="/co-funding" class="hover:text-emerald-700 transition">Co-funding</a>
          <a href="/contact-us" class="hover:text-emerald-700 transition">Contact us</a>
          <a href="/news" class="hover:text-emerald-700 transition">News</a>
        </nav>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow max-w-4xl w-full mx-auto px-6 py-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-6">
      <div class="max-w-4xl mx-auto px-6 text-center text-xs text-slate-500">
        &copy; {new Date().getFullYear()} Pademelon Fund. All rights reserved.
      </div>
    </footer>
  </body>
</html>
