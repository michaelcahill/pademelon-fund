---
import BaseLayout from './BaseLayout.astro';
import EntryHeader from '../components/EntryHeader.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import type { GalleryImage } from '../lib/galleries';
import { FULL_GRID, FULL_WIDTH, TEXT_COLUMN } from '../lib/shell';

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  /** Images to display, usually from `getGalleryImages()`. */
  images: GalleryImage[];
  /** Lightbox group name — defaults to the gallery folder. */
  group?: string;
  /** CSS aspect-ratio per tile; match the source photos (default `3/2`). */
  aspect?: string;
  showCaptions?: boolean;
  /** Preview image; defaults to the first tile when no hero is given. */
  image?: string;
  imageAlt?: string;
  /** `og:type` — `article` for dated stories, `website` for pages. */
  ogType?: 'website' | 'article';
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  pubDate,
  images,
  group,
  aspect = '3/2',
  showCaptions = false,
  image,
  imageAlt,
  ogType,
  backHref,
  backLabel = 'Back',
} = Astro.props;

// A gallery has no hero of its own, so the first tile (filename order) stands in
// as the preview image; `src` is base-prefixed and `alt` is the caption.
const shareImage = image ?? images[0]?.src;
const shareAlt = imageAlt ?? images[0]?.alt;
---

<BaseLayout
  title={title}
  description={description}
  image={shareImage}
  imageAlt={shareAlt}
  ogType={ogType}
  pubDate={pubDate}
>
  <!-- Title, standfirst and the tile grid span the whole shell; prose reads in
       the right two columns (see src/lib/shell.ts). -->
  <article class:list={[FULL_GRID]}>
    <EntryHeader
      rootClass={FULL_WIDTH}
      title={title}
      description={description}
      pubDate={pubDate}
    />

    {
      /* Any prose the entry supplies is kept to a readable measure; the grid
         below uses the full width of the standard page shell. */
      <div class:list={['mt-2 max-w-prose', TEXT_COLUMN]}>
        <slot name="intro" />
      </div>
    }

    <div class:list={['mt-8', FULL_WIDTH]}>
      <GalleryGrid images={images} group={group ?? title} aspect={aspect} showCaptions={showCaptions} />
    </div>

    <!-- Extra prose: slot content supplies its own spacing. -->
    <div class:list={[TEXT_COLUMN]}>
      <slot />
    </div>

    {
      backHref ? (
        <div class:list={['hairline mt-12 pt-6', FULL_WIDTH]}>
          <a
            href={backHref}
            class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold"
          >
            &larr; {backLabel}
          </a>
        </div>
      ) : null
    }
  </article>
</BaseLayout>
