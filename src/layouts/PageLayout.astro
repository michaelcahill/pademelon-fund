---
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import EntryHeader from '../components/EntryHeader.astro';
import {
  FULL_GRID,
  FULL_WIDTH,
  PROSE_CLASS,
  TEXT_COLUMN,
} from '../lib/shell';

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
  /** Photo resolved by `photoFor()` — Astro builds the srcset at build time. */
  heroImage?: ImageMetadata;
  heroAlt?: string;
  /** `og:type` — `article` for dated stories, `website` for pages. */
  ogType?: 'website' | 'article';
  /** Renders a "back" link after the article body. */
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  description,
  pubDate,
  heroImage,
  heroAlt,
  ogType,
  backHref,
  backLabel = 'Back',
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  imageAlt={heroAlt}
  ogType={ogType}
  pubDate={pubDate}
>
  <!-- Title, standfirst and hero span the whole shell; only the body text is
       pulled into the right two columns (see src/lib/shell.ts). -->
  <article class:list={[FULL_GRID]}>
    <EntryHeader
      rootClass={FULL_WIDTH}
      title={title}
      description={description}
      pubDate={pubDate}
      heroImage={heroImage}
      heroAlt={heroAlt}
    />

    <!-- The typography plugin handles headings, lists, quotes and media. -->
    <div class:list={[PROSE_CLASS, 'mt-8', TEXT_COLUMN]}>
      <slot />
    </div>

    {
      backHref ? (
        <div class:list={['hairline mt-12 pt-6', FULL_WIDTH]}>
          <a
            href={backHref}
            class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold"
          >
            &larr; {backLabel}
          </a>
        </div>
      ) : null
    }

    <slot name="after" />
  </article>
</BaseLayout>
