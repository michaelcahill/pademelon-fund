---
import BaseLayout from "./BaseLayout.astro";
import { FULL_GRID, FULL_WIDTH, TEXT_COLUMN } from "../lib/shell";
import { withBase } from "../lib/paths";

interface CallToAction {
    href: string;
    label: string;
}

interface Props {
    title: string;
    /** Lead paragraph under the headline. */
    description?: string;
    /** Site-absolute path, e.g. `/images/about/team.jpg` (frontmatter style). */
    heroImage?: string;
    heroAlt?: string;
    /** First is rendered as the primary button; any second one is secondary. */
    ctas?: CallToAction[];
}

const { title, description, heroImage, heroAlt, ctas = [] } = Astro.props;
---

<BaseLayout title={title} description={description}>
    <!-- The hero spans the full shell; page sections read in the right two
         columns (see src/lib/shell.ts). -->
    <div class:list={["overflow-hidden", FULL_GRID]}>
        <!-- Hero -->
        <section class:list={["grid items-center gap-8", FULL_WIDTH]}>
            {ctas.length > 0 ? (
                <div class="mt-8 flex flex-wrap gap-3">
                    {ctas.map((cta, index) => (
                        <a
                            href={cta.href}
                            class:list={[
                                // 44px+ tap target for phones. Colours come from
                                // .btn / .btn-primary / .btn-secondary in global.css.
                                "btn inline-flex min-h-11 items-center justify-center px-5 text-sm font-semibold",
                                index === 0 ? "btn-primary" : "btn-secondary",
                            ]}
                        >
                            {cta.label}
                        </a>
                    ))}
                </div>
            ) : null}

            {heroImage ? (
                <img
                    src={withBase(heroImage)}
                    alt={heroAlt ?? ""}
                    // Full width, cropped to 16:9 — matches the aspect ratio
                    // used by gallery tiles. `object-cover` fills the box and
                    // crops the overflow so the hero is a clean landscape strip.
                    class="w-full aspect-[16/9] rounded-xl object-cover sm:rounded-2xl"
                    decoding="async"
                    fetchpriority="high"
                />
            ) : null}
        </section>

        <!-- Page sections (impact preview, gallery teaser, etc.) -->
        <div class:list={["mt-14", TEXT_COLUMN]}>
            <slot />
        </div>
    </div>
</BaseLayout>
