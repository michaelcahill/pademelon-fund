---
import BaseLayout from "./BaseLayout.astro";
import { withBase } from "../lib/paths";

interface CallToAction {
    href: string;
    label: string;
}

interface Props {
    title: string;
    /** Lead paragraph under the headline. */
    description?: string;
    /** Site-absolute path, e.g. `/images/about/team.jpg` (frontmatter style). */
    heroImage?: string;
    heroAlt?: string;
    /** First is rendered as the primary button; any second one is secondary. */
    ctas?: CallToAction[];
}

const { title, description, heroImage, heroAlt, ctas = [] } = Astro.props;
---

<BaseLayout title={title} description={description}>
    <div class="overflow-hidden">
        <!-- Hero -->
        <section class="grid items-center gap-8">
            {ctas.length > 0 ? (
                <div class="mt-8 flex flex-wrap gap-3">
                    {ctas.map((cta, index) => (
                        <a
                            href={cta.href}
                            class:list={[
                                // 44px+ tap target for phones.
                                "inline-flex min-h-11 items-center justify-center rounded-lg px-5 text-sm font-semibold transition",
                                index === 0
                                    ? "bg-emerald-700 text-white hover:bg-emerald-800"
                                    : "border border-slate-300 text-slate-700 hover:border-emerald-600 hover:text-emerald-700",
                            ]}
                        >
                            {cta.label}
                        </a>
                    ))}
                </div>
            ) : null}

            {heroImage ? (
                <img
                    src={withBase(heroImage)}
                    alt={heroAlt ?? ""}
                    // No fixed aspect ratio: let the image (e.g. a portrait logo) keep
                    // its natural shape instead of being cropped to a landscape box.
                    // Centered with mx-auto and sized with max-w so a portrait logo
                    // isn't stretched full-width.
                    class="mx-auto w-full max-w-sm rounded-xl object-contain sm:rounded-2xl"
                    decoding="async"
                    fetchpriority="high"
                />
            ) : null}
        </section>

        <!-- Page sections (impact preview, gallery teaser, etc.) -->
        <div class="mt-14">
            <slot />
        </div>
    </div>
</BaseLayout>
